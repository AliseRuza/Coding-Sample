. **** Defining a helper program for plotting
. * Plots one line per group (e.g. per age at first birth). Used for the descriptive graphs in 1b, 1c and 2b.
. capture program drop plot_by_group

. program define plot_by_group
  1.     syntax varlist(min=2 max=2), group(varname) [title(string) xtitle(string) ///
>         ytitle(string) xline(string) prefix(string) file(string) cols(integer 6)]
  2.     gettoken y x : varlist
  3.     levelsof `group', local(levels)
  4.     local n : word count `levels'
  5.     colorpalette hcl, n(`n') nograph
  6.     local i 0
  7.     local cmd ""
  8.     local leg ""
  9.     foreach g of local levels {
 10.         local ++i
 11.         local col `r(p`i')'
 12.         local cmd `"`cmd' (connected `y' `x' if `group' == `g', lwidth(medium) msymbol(D) msize(vsmall) lcolor("`col'") mcolor("`col'"))"'
 13.         local leg `"`leg' `i' "`prefix'`g'""'
 14.     }
 15.     if "`xline'" != "" local xl xline(`xline', lcolor(black) lpattern(dash))
 16.     twoway `cmd', title("`title'") xtitle("`xtitle'") ytitle("`ytitle'") `xl' ///
>         legend(order(`leg') size(vsmall) cols(`cols') pos(6))
 17.     if "`file'" != "" graph export "$out/`file'", replace
 18. end

