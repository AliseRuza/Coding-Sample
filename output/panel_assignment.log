. * Weighted average across sub-events for each event time; lincom gives the SE of the weighted sum, accounting for covariance between estimates.
. forvalues l = 0/`=`l_max'-`l_min'' {
  2.     local actual_l = `l' + `l_min'
  3.     if `actual_l' != -1 {
  4.         local lname = `actual_l' + `P'
  5.         local lincom_cmd ""
  6.         forvalues s = `s_min'/`s_max' {
  7.             local col = `s' - `s_min' + 1
  8.             local w = W[1, `col']
  9.             if "`lincom_cmd'" == "" local lincom_cmd "`w'*d_s`s'_l`lname'"
 10.             else local lincom_cmd "`lincom_cmd' + `w'*d_s`s'_l`lname'"
 11.         }
 12.         quietly lincom `lincom_cmd'
 13.         quietly replace wavg  = r(estimate) if evtime == `actual_l' & subevent == `s_min'
 14.         quietly replace wavg_lo = r(estimate) - 1.96*r(se) if evtime == `actual_l' & subevent == `s_min'
 15.         quietly replace wavg_hi = r(estimate) + 1.96*r(se) if evtime == `actual_l' & subevent == `s_min'
 16.     }
 17.     else {
 18.         quietly replace wavg = 0 if evtime == -1 & subevent == `s_min'
 19.         quietly replace wavg_lo = 0 if evtime == -1 & subevent == `s_min'
 20.         quietly replace wavg_hi = 0 if evtime == -1 & subevent == `s_min'
 21.     }
 22. }

